# Copy to mobile/.env. Restart `npx expo start` after changing it.

# Set to use the LibTrack backend (API mode). Leave unset for the offline mock.
#   Android emulator:  http://10.0.2.2:4000
#   Physical phone:    http://<your-computer-LAN-IP>:4000
#   Web / iOS sim:     http://localhost:4000
EXPO_PUBLIC_API_URL="http://10.0.2.2:4000"

# Optional: pin the app clock. Keep it equal to the backend's DEMO_NOW.
# EXPO_PUBLIC_DEMO_NOW=
