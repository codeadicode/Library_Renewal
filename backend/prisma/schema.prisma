generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CopyStatus {
  AVAILABLE
  ON_LOAN
  RESERVED
  MAINTENANCE
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  CANCELLED
}

enum NeedDecision {
  STILL_NEED
  DONE
  NOT_SURE
}

enum NotificationPreference {
  DIGEST
  IMPORTANT
  NORMAL
  QUIET
}

enum ResourceType {
  PHYSICAL
  DIGITAL
  BOTH
}

enum AssessmentType {
  EXAM
  ASSIGNMENT
  PROJECT
  INTERNAL
  OTHER
}

model User {
  id                     String                 @id @default(uuid())
  studentId              String                 @unique
  name                   String
  email                  String                 @unique
  passwordHash           String
  course                 String
  academicYear           String
  restricted             Boolean                @default(false)
  notificationPreference NotificationPreference @default(NORMAL)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  loans                  Loan[]
  reservations           Reservation[]
  academicNeeds          AcademicNeed[]
  notifications          Notification[]
  fines                  FineLedger[]
  recommendationFeedback RecommendationFeedback[]
}

model Topic {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  bookTopics  BookTopic[]
}

model Course {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  department  String?
  bookCourses BookCourse[]
}

model Book {
  id            String        @id @default(uuid())
  title         String
  author        String
  isbn          String        @unique
  description   String
  category      String
  academicLevel String
  resourceType  ResourceType  @default(PHYSICAL)
  renewable     Boolean       @default(true)
  digitalUrl    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  copies          BookCopy[]
  topics          BookTopic[]
  courses         BookCourse[]
  reservations    Reservation[]
  loans           Loan[]
  recommendations Recommendation[] @relation("SourceBook")
  asAlternative   Recommendation[] @relation("TargetBook")
}

model BookCopy {
  id        String     @id @default(uuid())
  bookId    String
  code      String     @unique
  status    CopyStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  book  Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  loans Loan[]

  @@index([bookId, status])
}

model BookTopic {
  bookId  String
  topicId String

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([bookId, topicId])
  @@index([topicId])
  @@index([bookId])
}

model BookCourse {
  bookId   String
  courseId String

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([bookId, courseId])
  @@index([courseId])
  @@index([bookId])
}

model Loan {
  id              String        @id @default(uuid())
  copyId          String
  userId          String
  bookId          String
  issuedAt        DateTime      @default(now())
  dueAt           DateTime
  returnedAt      DateTime?
  status          LoanStatus    @default(ACTIVE)
  renewalCount    Int           @default(0)
  markedForReturn Boolean       @default(false)
  needDecision    NeedDecision?
  followUpAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  copy            BookCopy         @relation(fields: [copyId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  book            Book             @relation(fields: [bookId], references: [id])
  renewalAttempts RenewalAttempt[]
  fines           FineLedger[]

  @@index([userId, status])
  @@index([copyId])
  @@index([dueAt])
}

model Reservation {
  id        String            @id @default(uuid())
  bookId    String
  userId    String
  status    ReservationStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  book Book @relation(fields: [bookId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([bookId, status])
  @@index([userId, status])
}

model RenewalAttempt {
  id         String   @id @default(uuid())
  loanId     String
  eligible   Boolean
  reasonCode String
  reason     String
  newDueAt   DateTime?
  createdAt  DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
}

model AcademicNeed {
  id             String         @id @default(uuid())
  userId         String
  course         String
  topic          String
  assessmentType AssessmentType @default(INTERNAL)
  assessmentDate DateTime
  neededUntil    DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  kind      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model FineLedger {
  id        String   @id @default(uuid())
  userId    String
  loanId    String?
  amount    Float
  reason    String
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan Loan? @relation(fields: [loanId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model LibraryPolicy {
  id                 String   @id @default(uuid())
  name               String
  maxRenewals        Int      @default(2)
  loanPeriodDays     Int      @default(14)
  renewalPeriodDays  Int      @default(14)
  upcomingDays       Int      @default(7)
  approachingMinDays Int      @default(4)
  approachingMaxDays Int      @default(7)
  urgentMaxDays      Int      @default(3)
  finePerDay         Float    @default(5.0)
  weightMetadata     Float    @default(0.40)
  weightTfidf        Float    @default(0.35)
  weightCourse       Float    @default(0.15)
  weightLevel        Float    @default(0.10)
  isDefault          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Recommendation {
  id           String   @id @default(uuid())
  userId       String
  sourceBookId String
  targetBookId String
  score        Float
  reasons      String[]
  createdAt    DateTime @default(now())

  sourceBook Book                     @relation("SourceBook", fields: [sourceBookId], references: [id], onDelete: Cascade)
  targetBook Book                     @relation("TargetBook", fields: [targetBookId], references: [id], onDelete: Cascade)
  feedback   RecommendationFeedback[]

  @@index([userId, sourceBookId])
}

model RecommendationFeedback {
  id               String   @id @default(uuid())
  userId           String
  recommendationId String
  helpful          Boolean
  comment          String?
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
}
