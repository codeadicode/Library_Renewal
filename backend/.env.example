# Copy to backend/.env and adjust.

# PostgreSQL connection (matches docker-compose.yml at the repo root).
DATABASE_URL="postgresql://libtrack:libtrack@localhost:5432/libtrack"

# REQUIRED outside development: a random string of at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# With NODE_ENV=production the server refuses to start without it.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# postgres (default) or memory. "memory" is for offline demos only: nothing persists.
# DATA_STORE=postgres

# Optional: pin the clock for demos, e.g. 2026-11-21T09:00:00+05:30.
# Re-run `npm run db:seed` after changing it so the seeded loans line up.
# DEMO_NOW=

# Notification scheduler (follow-ups, digests, due-date reminders).
# SCHEDULER_INTERVAL_MS=60000   # 0 disables it
# DIGEST_HOUR=9                 # local hour for DIGEST deliveries

# Only for `npm run test:db` (this database is wiped and re-seeded).
# TEST_DATABASE_URL="postgresql://libtrack:libtrack@localhost:5432/libtrack_test"
